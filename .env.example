# ---------------------------------------------------------------------------------
# Canada Recall Alert - Production & Deployment Environment Variables
# In release/symlink deployments (deploy/current/), this file lives in deploy/.env
#
# NOTE: Variables meant for the frontend MUST be prefixed with VITE_
# (e.g., VITE_API_KEY) so Vite and import.meta.env properly expose them to client code.
# ---------------------------------------------------------------------------------

# Frontend Variables (Exposed to import.meta.env)
# Gemini 3.5 Flash Lite API Key for AI visual packaging & product verification
# Free API key: https://aistudio.google.com/app/apikey
VITE_API_KEY=AIzaSy...
VITE_GEMINI_API_KEY=AIzaSy...
VITE_VAPID_PUBLIC_KEY=

# Alternative recognized frontend variable names:
# VITE_GOOGLE_API_KEY=AIzaSy...
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_API_KEY=AIzaSy...

# Backend & Background Worker Variables (Node / Server Only)
# Web Push VAPID credentials (generated via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@canada-recall.internal

# Server Port (optional, defaults to 3000)
PORT=3000
